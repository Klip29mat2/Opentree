{
  "name": "opentree",
  "version": "1.0.0",
  "description": "Procedural tree generator",
  "author": {
    "name": "OpenTree",
    "email": "contact@example.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"vite\" \"electron .\"",
    "dev": "vite",
    "build": "vite build",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:windows": "npm run build && electron-builder --win nsis",
    "dist:all": "npm run build && electron-builder --linux AppImage deb && electron-builder --win nsis"
  },
  "dependencies": {
    "@comfyorg/fbx-exporter-three": "^1.0.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@xyflow/react": "^12.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.opentree.app",
    "productName": "OpenTree",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "linux": {
      "category": "Graphics",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "contact@example.com",
      "synopsis": "Procedural 3D tree generator",
      "description": "OpenTree is a procedural 3D tree generator."
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenTree"
    }
  }
}
